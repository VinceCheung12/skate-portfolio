---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, date, cover, camera, tags } = project.data;

const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — 滑板作品集`}>
  <article class="project-detail">
    <div class="container">
      <a href={import.meta.env.BASE_URL} class="back-link">&larr; 返回首页</a>
      <div class="cover-image">
        <img src={cover.startsWith('/') ? import.meta.env.BASE_URL + cover.slice(1) : cover} alt={title} />
      </div>
      <div class="meta">
        <h1 class="title">{title}</h1>
        <time class="date">{formattedDate}</time>
        {camera && <span class="camera">📷 {camera}</span>}
        {tags && tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
      <div class="content">
        {project.body ? (
          // 手动渲染 body 内容
          <div set:html={project.body} />
        ) : (
          <p>暂无详细描述。</p>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    padding: 3rem 0;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .cover-image {
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .cover-image img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .meta {
    margin-bottom: 2rem;
  }

  .title {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .date {
    display: inline-block;
    color: #666;
    font-size: 0.9rem;
    margin-right: 1rem;
  }

  .camera {
    display: inline-block;
    color: #a0a0a0;
    font-size: 0.9rem;
  }

  .tags {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    padding: 0.25rem 0.7rem;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 20px;
    font-size: 0.8rem;
    color: #c4b5fd;
  }

  .content {
    color: #a0a0a0;
    line-height: 2;
    font-size: 1rem;
  }

  .content :global(p) {
    margin-bottom: 1rem;
  }

  .content :global(h2) {
    color: #f0f0f0;
    font-size: 1.3rem;
    margin: 1.5rem 0 0.75rem;
  }

  .content :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    border: none;
    margin: 1rem 0;
  }
</style>
