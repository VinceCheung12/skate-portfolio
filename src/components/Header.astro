---
---

<header class="header">
  <div class="container">
    <a href={import.meta.env.BASE_URL} class="logo">🛹 滑板作品集</a>
    <nav>
      <a href={import.meta.env.BASE_URL}>首页</a>
      <a href="#about">关于我</a>
      <a href="#contact">联系</a>
    </nav>
  </div>
</header>

<style>
  .header {
    padding: 1.25rem 0;
    border-bottom: 1px solid #1e1e1e;
    position: sticky;
    top: 0;
    background: rgba(15, 15, 15, 0.92);
    backdrop-filter: blur(8px);
    z-index: 10;
  }

  .header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f0f0f0;
  }

  .logo:hover {
    color: #a78bfa;
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a {
    font-size: 0.9rem;
    color: #a0a0a0;
  }

  nav a:hover {
    color: #f0f0f0;
  }
</style>
